# Guardian Enviroclean — environment variables (names only, no secrets).
# Never commit .env.local (or any other real env file).

# Neon (database, auth, object storage)
#
# DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_BRANCH, NEON_AUTH_BASE_URL,
# NEON_AUTH_JWKS_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_ENDPOINT_URL_S3, AWS_REGION are NOT listed here — they are pulled
# automatically into .env.local by `neon link` / `neon checkout` /
# `neon config apply` (neon deploy), not set by hand. Run those commands
# instead of copying values into this file. See docs/neon-foundation.md.

# App secret for Managed Better Auth's cached session cookies.
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Server-only allowlist of Job Manager admin emails (comma-separated).
# Checked against the verified Better Auth session server-side — see
# docs/neon-foundation.md ("Admin authorization").
ADMIN_EMAILS=

# Resend (quote-enquiry email notifications to Cecil)
RESEND_API_KEY=
# Must be an address on a domain verified in the Resend account —
# see docs/neon-foundation.md ("Quote Request Pipeline — Pass 3").
RESEND_FROM_EMAIL=
CECIL_NOTIFICATION_EMAIL=

# Cloudflare Turnstile (spam protection on the public quote-request form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Site
NEXT_PUBLIC_SITE_URL=
